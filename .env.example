# Copy to .env.local. Everything is optional; the app degrades gracefully without each key.

# Microsoft Decision-1 on Azure AI Foundry: reads the request (intent, diet, biomarker lens, budget)
# and picks USDA components for menu items without published nutrition. Unset = keyword heuristics only.
AZURE_DECISION_ENDPOINT=
AZURE_DECISION_KEY=
AZURE_DECISION_DEPLOYMENT=decision-1

# Snapshot mode: search the crawled dataset in-process (what production runs; no browser needed).
# Leave unset to search Uber Eats live through the local Chrome helper (`bun run bridge`).
DATASET_LOCAL=1

# Optional Google Maps delivery-point picker. OpenStreetMap (Leaflet) is used when unset.
GOOGLE_MAPS_API_KEY=

# Optional DoorDash Drive credentials for delivery quotes (can also be entered in the UI).
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=

# Only needed to publish a re-crawled dataset (`npm run data:push`). `vercel env pull` writes it here.
# BLOB_READ_WRITE_TOKEN=
# Download the dataset from a different Blob store than data/manifest.json names.
# DATASET_BASE_URL=
